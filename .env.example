# Nexus Environment Configuration

# ==============================================================================
# Database Configuration
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
# Connection pool settings (optional - defaults shown)
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Application Settings
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==============================================================================
# Worker Configuration
# ==============================================================================
WORKER_COUNT=3
JOB_TIMEOUT_SECONDS=300
POLL_INTERVAL_SECONDS=1
MAX_RETRIES=3

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# Options: mock, openai
LLM_PROVIDER=mock
# OpenAI API Key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-api-key-here

# ==============================================================================
# API Configuration
# ==============================================================================
RATE_LIMIT_PER_MINUTE=60
# API server port (Railway overrides this with PORT)
API_PORT=8000

# ==============================================================================
# Monitoring
# ==============================================================================
METRICS_PORT=9090
# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_URL=http://localhost:3000
# OpenTelemetry Distributed Tracing
OTEL_ENABLED=true                              # Set to false to disable tracing
OTEL_SERVICE_NAME=nexus                        # Service name in Jaeger/Tempo
OTEL_EXPORTER_ENDPOINT=http://localhost:4317   # Jaeger (local) or Grafana Cloud OTLP gateway
OTEL_EXPORTER_PROTOCOL=grpc                    # grpc for Jaeger, http for Grafana Cloud
OTEL_EXPORTER_HEADERS=                         # Authorization=Basic <token> for Grafana Cloud
OTEL_INSECURE=true                             # false for TLS (production)